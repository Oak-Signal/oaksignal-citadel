# Variable names only. Never commit real values. Copy to .env.local for local development.
# See docs/environments.md for where each value comes from.

# Clerk (Next.js app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex (Next.js app)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Public site (Next.js app): absolute origin for sitemap, robots and sharing previews, for example
# https://citadel.example.org. Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Convex deployment environment (set in the Convex dashboard, not in .env.local):
#   CLERK_JWT_ISSUER_DOMAIN
